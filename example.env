# AlphaEvolve Clinical Classifier — Local Configuration
# Copy to .env and set your GCP PROJECT_ID:  cp example.env .env

# --- GCP project ------------------------------------------------------------
PROJECT_ID=alphaevolve-classifier-example

# --- AlphaEvolve API (Gemini Enterprise / Discovery Engine) ----------------
# Set LOCATION to match your Gemini Enterprise app region (us, eu, or global).
# Regional endpoints (us-discoveryengine.googleapis.com) are selected automatically from LOCATION.
LOCATION=us
COLLECTION=default_collection
GE_APP_ID=alphaevolve-classifier
ASSISTANT=default_assistant
BASE_URL=discoveryengine.googleapis.com

# --- Models (weighted mixture; weights normalized server-side) --------------
MODEL_1=gemini-3.5-flash
MODEL_1_WEIGHT=0.8
MODEL_2=gemini-3.1-pro-preview
MODEL_2_WEIGHT=0.2

# --- Experiment budget ------------------------------------------------------
MAX_PROGRAMS_GENERATED=40
MAX_PROGRAMS_EVALUATED=40
CONCURRENCY=6
WORKER_CONCURRENCY=2
PARALLEL_EVALUATION=False
SAVE_PROGRAM_DIR=artifacts/runs

# --- Local private evaluation seeds (SECRET: do not commit .env) ------------
# Generated automatically by `bash scripts/provision_gcp.sh`, or set two random integers:
#   python3 -c "import secrets; print(secrets.randbelow(2_000_000_000) + 100_000)"
AE_PERTURB_SEED=
AE_HELDOUT_SEED=

# Corp workstations: google-auth tries mTLS via the enterprise cert helper, which crashes (exit -11).
# Discovery Engine does not require mTLS, so disable client certs for the AlphaEvolve client.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
IDLE_TIMEOUT_S=900
